# ============================================================
# 환경 변수 템플릿 — 실제 값은 .env(git 제외)에만 넣는다 (AGENTS.md 규칙 8, 13)
# 시크릿(Client Secret, 비밀번호 등)은 채팅·이슈·로그에 절대 붙여넣지 않는다
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://app:changeme@localhost:55432/auction

# --- CODEF (등기부 중계 API, https://developer.codef.io) ---
# API_BASE: 데모=https://development.codef.io / 정식=https://api.codef.io
CODEF_API_BASE=https://development.codef.io
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
# 공개키(비밀 아님): 계정 비밀번호 필드 RSA 암호화용 — codef 계정 발급 값
CODEF_PUBLIC_

# --- 인터넷등기소 (등기부 열람 API 호출 시 CODEF 요청에 포함) ---
# 확인됨(WP-04, 2026-07-08): CODEF 요청은 인터넷등기소 로그인 계정을 쓰지 않는다 — 아래
# IROS_MEMBER_ID/PW는 이 API 흐름에서 실제로 사용되지 않는 것으로 확인됨 (다른 용도 대비 보관).
IROS_MEMBER_ID=
IROS_MEMBER_PW=
# CODEF 요청의 phoneNo 필드 — 전자민원캐시에 연결된 실제 등록 전화번호 (하이픈 없이 숫자만)
IROS_PHONE_NO=
# 전자민원캐시(선불지급수단, https://minwon.cashgate.co.kr/mcIros.do 에서 충전) — 열람 실비 700원 결제용.
# ePrepayPass는 RSA 암호화하지 않고 평문으로 전송한다 (확인됨). password 필드(재열람용 4자리 PIN,
# 로그인 비밀번호 아님)는 요청 시 코드에서 직접 생성해 RSA 암호화하므로 여기 별도 env가 필요 없다.
IROS_EPREPAY_NO=
IROS_EPREPAY_PASS=

# --- 공공데이터포털 (data.go.kr — 실거래가/건축물대장/토지대장) ---
DATA_GO_KR_SERVICE_KEY=

# --- 지도 ---
NCP_MAPS_CLIENT_ID=
NCP_MAPS_CLIENT_SECRET=
KAKAO_REST_API_KEY=
# apps/web 지도 화면(Web Dynamic Map) 실행용 — NCP_MAPS_CLIENT_ID와 같은 값을 apps/web 실행 환경에
# NEXT_PUBLIC_NCP_MAPS_CLIENT_ID로 노출해야 한다(공개값, README 실행 방법 참고). 값 자체는 여기 두지 않는다.
NEXT_PUBLIC_NCP_MAPS_CLIENT_ID=

# --- 인증 (WP-08 — 카카오·네이버 2종, D-015) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# OAuth state 서명 전용 시크릿 (WP-08b — JWT 시크릿과 분리, RFC 8725 §3.5)
OAUTH_STATE_SECRET=
# FCM 서비스 계정 키 경로 (WP-09 §0-2). 발송 CLI(pnpm --filter @auction/api notify)만 쓴다.
# 레포 밖에 두고 정슬래시로 적을 것 — dotenv가 큰따옴표 안의 \r 등을 이스케이프로 해석해 경로가 깨진다.
FCM_SERVICE_ACCOUNT_PATH=
# 카카오 OAuth의 client_id는 REST API 키와 같은 값이다 (카카오는 앱당 REST API 키 1개)
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# --- 수집기 ---
COURT_AUCTION_BASE_URL=https://www.courtauction.go.kr
COLLECTOR_REQUEST_INTERVAL_MS=1500
COLLECTOR_MAX_RETRY=3
# 매각물건명세서 PDF의 표 구조를 읽는 opendataloader-pdf 는 JAR 이라 Java 11+ 가 필요하다.
# PATH 의 java 가 구버전으로 잡히는 PC 가 있어(실측: C:\Windows\System32\java.exe = Java 8)
# 경로를 직접 지정한다. 비워두면 PATH 의 java 를 쓴다.
COLLECTOR_JAVA=C:\Program Files\Java\jdk-21.0.10\bin\java.exe

# CODEF OAuth 서버 (기본값 사용 — 바꿀 일이 거의 없다)
CODEF_OAUTH_BASE=https://oauth.codef.io
